# cordis.patch.yml 模板 —— 复制到 ~/.dsh/profiles/web/cordis.patch.yml
# 占位符：<USERPROFILE> 替换为目标机器的用户目录（如 C:\Users\zhangsan）；
#         <USERPROFILE_URL> 替换为 file:///C:/Users/zhangsan 形式（把反斜杠换成斜杠）
# 注意：remote-web-ui 的配置由 dsh-start.ps1 动态写入 settings.yaml（publicBaseUrl），
#       这里不需要也不应该配置 autoTunnel / publicBaseUrl。

# agent-instructions: 只读 AGENTS.md（CLAUDE.md 不读）
- id: agent-instructions
  config:
    maxBytes: 65536
    instructionFileCandidates:
      - AGENTS.md
    localInstructionFileCandidates: []

# Academic-search MCP（nature-academic-search 技能自带，uv 运行；需先装 uv）
- insert:
    - id: mcp-academic-search
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: academic-search
        transport: stdio
        command: uv
        args:
          - run
          - --python
          - '3.11'
          - --no-project
          - --directory
          - <USERPROFILE>\.dsh\skills\nature-academic-search\mcp-server
          - --with
          - 'mcp>=1.0.0,<2.0.0'
          - --with
          - 'requests>=2.28.0,<3.0.0'
          - --with
          - 'toml>=0.10.2,<2.0.0'
          - --with
          - 'lxml>=4.9.0,<5.0.0'
          - --with
          - 'pybliometrics>=4.4.1,<5.0.0'
          - python
          - academic_search_server.py
        env:
          PUBMED_EMAIL: !!js process.env.PUBMED_EMAIL ?? ''

# dsh-session-search: index-free cross-agent session search（手动挂载，非 bundle）
# name 使用 <USERPROFILE_URL>（安装时替换成 file:///C:/Users/... 格式）
- insert:
    - id: dsh-session-search
      name: 'file:///<USERPROFILE_URL>/Downloads/dsh-setup-kit/plugins-src/dsh-session-search/lib/index.js'
      config:
        sources:
          dsh: true
          codex: true
          claude: true
          pi: true
          opencode: true
        maxResults: 10
        readWindow: 10
